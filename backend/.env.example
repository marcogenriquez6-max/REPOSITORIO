# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=https://unior.edu.bo

# Database (PostgreSQL)
DATABASE_URL=postgresql://unior:unior_secret@localhost:5432/unior_repo?schema=public

# JWT (required: at least 32 random characters, different from each other)
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_ROOT=./storage
MAX_FILE_SIZE_BYTES=20971520

# Seed passwords (required: no defaults are used)
SEED_ADMIN_PASSWORD=REPLACE_ME
SEED_REVIEWER_PASSWORD=REPLACE_ME
SEED_DEPOSITOR_PASSWORD=REPLACE_ME
