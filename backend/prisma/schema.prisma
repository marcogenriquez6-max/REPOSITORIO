// Repositorio Institucional UNIOR (DSpace 7, Dublin Core)
// PostgreSQL | Prisma ORM

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext(schema: "public"), pg_trgm(schema: "public")]
}

enum UserRole {
  ADMIN
  REVISOR
  DEPOSITANTE
}

enum ItemStatus {
  BORRADOR
  EN_REVISION
  OBSERVADO
  PUBLICADO
  EMBARGADO
}

enum BitstreamBundle {
  ORIGINAL
  THUMBNAIL
  LICENCIA
}

enum WorkflowAction {
  ENVIADO
  REVISION_INICIADA
  APROBADO
  OBSERVADO
  DEVUELTO
  RECHAZADO
  PUBLICADO
  EMBARGADO
}

enum ObservationType {
  OBSERVACION
  DEVOLUCION
  RECHAZO
}

enum ObservationStatus {
  PENDIENTE
  RESUELTA
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique @db.Citext
  passwordHash      String         @map("password_hash")
  fullName          String         @map("full_name")
  role              UserRole
  isActive          Boolean        @default(true) @map("is_active")
  tokenVersion      Int            @default(0) @map("token_version")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?      @map("last_login_at") @db.Timestamptz(6)
  assignedFaculties UserFaculty[]
  createdItems      Item[]         @relation("ItemCreator")
  assignedItems     Item[]         @relation("ItemAssignedReviewer")
  workflowLogs      WorkflowLog[]  @relation("WorkflowActor")
  reviewChecks      ReviewCheck[]  @relation("ReviewCheckAuthor")
  observations      Observation[]  @relation("ObservationAuthor")
  resolvedObservations Observation[] @relation("ObservationResolver")

  @@index([role])
  @@index([isActive])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("users")
}

model UserFaculty {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
  @@map("user_faculties")
}

model Community {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  slug             String
  shortDescription String?        @map("short_description")
  isActive         Boolean        @default(true) @map("is_active")
  sortOrder        Int            @default(0) @map("sort_order")
  parentId         String?        @map("parent_id") @db.Uuid
  parent           Community?     @relation("CommunityHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children         Community[]    @relation("CommunityHierarchy")
  collections      Collection[]
  assignedUsers    UserFaculty[]
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([parentId, sortOrder])
  @@index([isActive, sortOrder, name])
  @@map("communities")
}

model Collection {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  slug            String
  shortDescription String?  @map("short_description")
  licenseText     String?   @map("license_text")
  workflowEnabled Boolean   @default(true) @map("workflow_enabled")
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")
  communityId     String    @map("community_id") @db.Uuid
  community       Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  items           Item[]
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([communityId, slug])
  @@index([communityId])
  @@index([communityId, sortOrder])
  @@index([isActive, sortOrder, name])
  @@map("collections")
}

model Item {
  id           String          @id @default(uuid()) @db.Uuid
  status       ItemStatus      @default(BORRADOR)
  embargoDate  DateTime?       @map("embargo_date") @db.Date
  viewCount    Int             @default(0) @map("view_count")
  handleUri    String?         @unique @map("handle_uri")
  submittedAt  DateTime?       @map("submitted_at") @db.Timestamptz(6)
  publishedAt  DateTime?       @map("published_at") @db.Timestamptz(6)
  collectionId String          @map("collection_id") @db.Uuid
  collection   Collection      @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  creatorId    String          @map("creator_id") @db.Uuid
  creator      User            @relation("ItemCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignedReviewerId String?   @map("assigned_reviewer_id") @db.Uuid
  assignedReviewer User?       @relation("ItemAssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  version      Int             @default(0)
  metadata     MetadataValue[]
  bitstreams   Bitstream[]
  workflowLogs WorkflowLog[]
  reviewChecks ReviewCheck[]
  observations Observation[]
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([collectionId, status])
  @@index([creatorId])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, submittedAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
  @@index([assignedReviewerId, status])
  @@index([embargoDate])
  @@map("items")
}

model MetadataValue {
  id        BigInt  @id @default(autoincrement())
  schema    String  @default("dc") @db.VarChar(32)
  element   String  @db.VarChar(64)
  qualifier String? @db.VarChar(64)
  value     String  @db.Text
  lang      String? @default("es") @db.VarChar(16)
  place     Int     @default(0)
  itemId    String  @map("item_id") @db.Uuid
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, element, qualifier, place])
  @@index([schema, element, qualifier])
  @@index([element, qualifier])
  @@map("metadata_values")
}

model Bitstream {
  id            String          @id @default(uuid()) @db.Uuid
  filePath      String          @map("file_path")
  originalName  String          @map("original_name")
  mimeType      String          @map("mime_type") @db.VarChar(255)
  sizeBytes     BigInt          @map("size_bytes")
  sha256Hash    String          @map("sha256_hash") @db.Char(64)
  bundle        BitstreamBundle
  downloadCount Int             @default(0) @map("download_count")
  isPrimary     Boolean         @default(false) @map("is_primary")
  description   String?
  content       Bytes?
  itemId        String          @map("item_id") @db.Uuid
  item          Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemId])
  @@index([itemId, bundle])
  @@index([itemId, isPrimary, createdAt])
  @@index([sha256Hash])
  @@index([downloadCount(sort: Desc)])
  @@map("bitstreams")
}

model WorkflowLog {
  id         BigInt         @id @default(autoincrement())
  action     WorkflowAction
  comment    String?        @db.Text
  fromStatus ItemStatus?    @map("from_status")
  toStatus   ItemStatus?    @map("to_status")
  itemId     String         @map("item_id") @db.Uuid
  item       Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actorId    String         @map("actor_id") @db.Uuid
  actor      User           @relation("WorkflowActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@map("workflow_logs")
}

model ReviewCheck {
  id          BigInt   @id @default(autoincrement())
  itemId      String   @map("item_id") @db.Uuid
  key         String   @db.VarChar(64)
  label       String   @db.VarChar(255)
  passed      Boolean
  notes       String?  @db.Text
  checkedById String   @map("checked_by_id") @db.Uuid
  checkedAt   DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  checkedBy   User     @relation("ReviewCheckAuthor", fields: [checkedById], references: [id], onDelete: Restrict)

  @@unique([itemId, key])
  @@index([itemId])
  @@map("review_checks")
}

model Observation {
  id           BigInt            @id @default(autoincrement())
  itemId       String            @map("item_id") @db.Uuid
  authorId     String            @map("author_id") @db.Uuid
  type         ObservationType   @default(OBSERVACION)
  description  String            @db.Text
  status       ObservationStatus @default(PENDIENTE)
  response     String?           @db.Text
  resolvedById String?           @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?         @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  item         Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author       User              @relation("ObservationAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  resolvedBy   User?             @relation("ObservationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([itemId, status])
  @@index([itemId, createdAt(sort: Desc)])
  @@index([status])
  @@map("observations")
}
